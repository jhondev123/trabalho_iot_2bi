# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# O .env.local está no .gitignore: as senhas reais nunca vão para o git.
# Em produção (Vercel ou npm run build + npm start) SESSION_SECRET, SENHA_ALUNO e SENHA_ADMIN
# são obrigatórias. No npm run dev elas têm valor de teste.

# Segredo que assina o cookie de login. Use um texto longo e aleatório.
# Sem ela o login dá erro (de propósito: com um segredo padrão daria para forjar o cookie de admin).
SESSION_SECRET=troque-por-um-texto-longo

# Senhas dos logins do site (usuário "aluno" e usuário "admin").
SENHA_ALUNO=troque-a-senha-do-aluno
SENHA_ADMIN=troque-a-senha-do-admin

# Prefixo dos tópicos MQTT. Tem que ser igual ao MQTT_PREFIXO do firmware (secrets.h) e o mesmo
# valor vale para o navegador. Dica: use um prefixo único do grupo, por exemplo academia/armario-g7k2q9
NEXT_PUBLIC_MQTT_PREFIXO=academia/armario

# Broker usado pelo navegador (WebSocket com TLS) e pelo servidor (MQTT com TLS, porta 8883).
NEXT_PUBLIC_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_URL_SERVIDOR=mqtts://broker.hivemq.com:8883

# Senha de admin que o ESP32 espera dentro do comando abrir (ADMIN_SENHA no firmware/secrets.h).
# Use uma senha DIFERENTE de SENHA_ADMIN: esta trafega dentro do comando MQTT.
ADMIN_SENHA_ARMARIO=admin123
