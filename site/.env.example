# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Só SESSION_SECRET é obrigatória em produção (Vercel ou npm start). As outras têm valor padrão.

# OBRIGATÓRIA em produção: segredo que assina o cookie de login. Use um texto longo e aleatório.
# Sem ela o login dá erro (de propósito: com um segredo padrão daria para forjar o cookie de admin).
SESSION_SECRET=troque-por-um-texto-longo

# Prefixo dos tópicos MQTT. Tem que ser igual ao do ESP32 (sketch.ino) e o mesmo valor
# vale para o navegador. Dica: use um prefixo único do grupo, por exemplo academia/armario/grupo-xyz123
NEXT_PUBLIC_MQTT_PREFIXO=academia/armario

# Broker usado pelo navegador (WebSocket seguro) e pelo servidor (TCP).
NEXT_PUBLIC_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_URL_SERVIDOR=mqtt://broker.hivemq.com:1883

# Senha de admin que o ESP32 espera dentro do comando abrir (ADMIN_SENHA no firmware/sketch.ino).
ADMIN_SENHA_ARMARIO=admin123
